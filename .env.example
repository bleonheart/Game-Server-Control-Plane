POSTGRES_PASSWORD=replace-with-a-strong-random-password
DATABASE_URL=postgres://gscp:replace-with-a-strong-random-password@postgres:5432/gscp?sslmode=disable
SECRET_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
BIND_ADDRESS=:8080
LOG_LEVEL=info
DATA_ROOT=/var/lib/game-control-plane/servers
DOCKER_DATA_ROOT=/absolute/host/path/to/game-server-control-plane/data/servers
BACKUP_ROOT=/var/lib/game-control-plane/backups
STEAMCMD_PATH=/usr/local/bin/steamcmd
DOCKER_BINARY=/usr/bin/docker
GARRYSMOD_IMAGE=game-server-control-plane/garrysmod:local
SESSION_TTL=24h
SCHEDULER_INTERVAL=15s
ALLOWED_PORT_MIN=20000
ALLOWED_PORT_MAX=40000
METRICS_ENABLED=true
DEV_SEED=false
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=replace-with-a-strong-demo-password
